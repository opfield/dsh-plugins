{
  "name": "@opfield/dsh-mcp-hub",
  "version": "0.4.1",
  "description": "MCP Hub for DeepSeek Harness: every MCP server in one place, per-server eager / lazy / auto tool exposure, OAuth for HTTP servers, direct node launch of npx packages, and the mcpHub service for plugins that contribute servers",
  "license": "MIT",
  "author": "Opfield",
  "homepage": "https://github.com/opfield/dsh-plugins/tree/main/packages/mcp-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opfield/dsh-plugins.git",
    "directory": "packages/mcp-hub"
  },
  "bugs": {
    "url": "https://github.com/opfield/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./types/mcp-hub.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./types": "./types/mcp-hub.d.ts",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "install.js",
    "catalog.js",
    "oauth.js",
    "server.js",
    "launcher.js",
    "client.js",
    "types/*.d.ts",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.mjs'"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "oauth"
  ],
  "types": "./types/mcp-hub.d.ts"
}
